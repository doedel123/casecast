# --- Database (auto-provisioned by the Neon integration on Vercel) ---
# vercel env pull .env.local --yes
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth ---
# openssl rand -base64 32
AUTH_SECRET=

# --- Stripe (Vercel Marketplace "Stripe" integration or your own keys) ---
# STRIPE_SECRET_KEY is preferred; STRIPE_API_KEY is read as a fallback.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# or the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Optional: pin a specific price; otherwise the app finds-or-creates a
# $7.99/month price by lookup key on first checkout.
STRIPE_PRICE_ID=

# --- Cloudflare Turnstile (optional in dev; recommended in production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
# Absolute URL used in Stripe redirects & metadata (falls back to request origin)
NEXT_PUBLIC_APP_URL=

# --- Analytics (set in production only so dev/preview traffic isn't tracked) ---
NEXT_PUBLIC_GA_ID=

# --- Seeding (optional overrides for scripts/seed.ts) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
